# Store credentials for running tools/publish-*.mjs locally.
# Copy to .env (git-ignored), fill in, then run:
#   node --env-file=.env tools/publish-chrome.mjs dist/figma-return-chrome-<version>.zip
#   node --env-file=.env tools/publish-firefox.mjs dist/figma-return-firefox-<version>.zip
# CI reads the same names from GitHub secrets, not from this file.

# Chrome Web Store. The key must be on one line in single quotes: jq -c . key.json
CWS_SERVICE_ACCOUNT_KEY=''
CWS_PUBLISHER_ID=
CWS_EXTENSION_ID=

# Firefox Add-ons: JWT issuer and secret
AMO_API_KEY=
AMO_API_SECRET=
